{
  "name": "helmd",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "test:preset": "node scripts/test-gen-preset.mjs",
    "test:seam": "node scripts/checks/session-log.check.mjs && node scripts/checks/prompt-assembly.check.mjs && node scripts/checks/bootstrap-anchor.check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
