{
  "name": "@adwmc/helm-d",
  "version": "0.4.1",
  "type": "module",
  "main": "dist/health.js",
  "types": "dist/health.d.ts",
  "exports": {
    ".": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./agent": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hcot-settings": {
      "types": "./dist/hcot-settings.d.ts",
      "default": "./dist/hcot-settings.js"
    },
    "./client": "./client.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "references",
    "scripts",
    "cordis.patch.yml",
    "preset.generated.patch.yml",
    "presets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.generated.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
